# Copia este archivo a .dev.vars para desarrollo local (no se sube a git).

# Permite probar con menos jugadores de los 5 que piden las reglas.
MIN_PLAYERS=3

# Base de datos (opcional). Sin estas dos líneas se juega igual, pero no se guarda nada
