{
  "name": "trazo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "wrangler types && tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/shared/game.test.ts",
